<Project>
  <!-- SSOT: sasist-agent/VERSION — every Agent assembly inherits this. -->
  <PropertyGroup>
    <_AgentVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)VERSION'))</_AgentVersionFile>
    <Version Condition="Exists('$(_AgentVersionFile)')">$([System.IO.File]::ReadAllText('$(_AgentVersionFile)').Trim())</Version>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
