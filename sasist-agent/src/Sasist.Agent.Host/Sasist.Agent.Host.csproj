<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sasist.Agent.Host</RootNamespace>
    <AssemblyName>Sasist.Agent.Host</AssemblyName>
    <Version>1.1.1</Version>
    <Product>Sasist Agent</Product>
    <AssemblyTitle>Sasist Agent</AssemblyTitle>
    <Company>Sasist</Company>
    <UserSecretsId>dotnet-Sasist.Agent.Host-eb35b91a-1a0d-4225-985b-ef4a81ec20c7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sasist.Agent.Core\Sasist.Agent.Core.csproj" />
    <!-- Shipping reference: DLL lands next to Host; loader discovers by convention (no Host code change for new Modules.* projects dropped into plugins/). -->
    <ProjectReference Include="..\Sasist.Agent.Modules.Printing\Sasist.Agent.Modules.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <Target Name="CopyModulePlugins" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_PluginOut Condition="'$(PublishDir)' != ''">$(PublishDir)plugins</_PluginOut>
      <_PluginOut Condition="'$(PublishDir)' == ''">$(OutputPath)plugins</_PluginOut>
      <_ModuleSrc Condition="'$(PublishDir)' != ''">$(PublishDir)</_ModuleSrc>
      <_ModuleSrc Condition="'$(PublishDir)' == ''">$(OutputPath)</_ModuleSrc>
    </PropertyGroup>
    <MakeDir Directories="$(_PluginOut)" />
    <ItemGroup>
      <_ModuleDll Include="$(_ModuleSrc)Sasist.Agent.Modules.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModuleDll)" DestinationFolder="$(_PluginOut)" SkipUnchangedFiles="true" Condition="'@(_ModuleDll)' != ''" />
  </Target>
</Project>
