<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <title>Korekta faktury {{ document.number }}</title>
  <style>{% include 'sale_document_base.css' %}</style>
</head>
<body>
  <h1>Korekta faktury {{ document.number }}</h1>
  <div class="meta">Data wystawienia: {{ document.date }}</div>
  <div class="meta">Dokument korygowany: {{ document.source_number }}</div>
  <div class="meta">Powód korekty: {{ document.reason }}</div>
  <div class="grid">
    <div class="box">
      <h2>Sprzedawca</h2>
      <div>{{ seller.name }}</div>
      <div>{{ seller.address }}</div>
      {% if seller.nip != "—" %}<div>NIP: {{ seller.nip }}</div>{% endif %}
    </div>
    <div class="box">
      <h2>Nabywca</h2>
      <div>{{ customer.name }}</div>
      <div>{{ customer.address }}</div>
      {% if customer.nip and customer.nip != "—" %}<div>NIP: {{ customer.nip }}</div>{% endif %}
    </div>
  </div>
  <p class="meta">Pozycje poniżej to <strong>różnice (delta)</strong> względem dokumentu źródłowego (ujemne = zmniejszenie sprzedaży).</p>
  <table>
    <thead>
      <tr>
        <th>Lp.</th>
        <th>Nazwa</th>
        <th class="num">Ilość (delta)</th>
        <th class="num">Cena netto</th>
        <th class="num">VAT %</th>
        <th class="num">Wartość netto</th>
        <th class="num">Kwota VAT</th>
        <th class="num">Brutto</th>
      </tr>
    </thead>
    <tbody>
      {% for row in items %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>{{ row.name }}{% if row.sku %} <span class="meta">({{ row.sku }})</span>{% endif %}</td>
        <td class="num">{{ row.quantity }}</td>
        <td class="num">{{ "%.2f"|format(row.unit_net or 0) }}</td>
        <td class="num">{{ row.vat_percent }}</td>
        <td class="num">{{ "%.2f"|format(row.line_net or 0) }}</td>
        <td class="num">{{ "%.2f"|format(row.line_vat or 0) }}</td>
        <td class="num">{{ "%.2f"|format(row.line_gross or 0) }}</td>
      </tr>
      {% else %}
      <tr><td colspan="8">Brak pozycji korekty</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="totals">
    <div>Netto: {{ totals.net }} {{ currency }}</div>
    <div>VAT: {{ totals.vat }} {{ currency }}</div>
    <div><strong>Brutto: {{ totals.gross }} {{ currency }}</strong></div>
  </div>
  {% if vat_rows %}
  <h2>Podsumowanie VAT</h2>
  <table>
    <thead>
      <tr>
        <th>Stawka</th>
        <th class="num">Netto</th>
        <th class="num">VAT</th>
        <th class="num">Brutto</th>
      </tr>
    </thead>
    <tbody>
      {% for vr in vat_rows %}
      <tr>
        <td>{{ vr.vat_percent }}%</td>
        <td class="num">{{ "%.2f"|format(vr.net) }}</td>
        <td class="num">{{ "%.2f"|format(vr.vat) }}</td>
        <td class="num">{{ "%.2f"|format(vr.gross) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</body>
</html>
